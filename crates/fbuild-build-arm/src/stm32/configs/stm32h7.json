{
  "name": "STM32H7",
  "description": "STM32H7xx (ARM Cortex-M7)",
  "architecture": "arm-cortex-m7",

  "compiler_flags": {
    "common": [
      "-mcpu=cortex-m7",
      "-mfloat-abi=hard",
      "-mfpu=fpv5-d16",
      "-mthumb",
      "-Wall",
      "-Wextra",
      "-Wno-unused-parameter",
      "-ffunction-sections",
      "-fdata-sections",
      "-MMD",
      "--specs=nano.specs"
    ],
    "c": [
      "-std=gnu11"
    ],
    "cxx": [
      "-std=gnu++17",
      "-fno-exceptions",
      "-fno-rtti",
      "-fno-threadsafe-statics"
    ]
  },

  "linker_flags": [
    "-mcpu=cortex-m7",
    "-mfloat-abi=hard",
    "-mfpu=fpv5-d16",
    "-mthumb",
    "-Wl,--gc-sections",
    "-Wl,--print-memory-usage",
    "--specs=nano.specs",
    "--specs=nosys.specs"
  ],

  "linker_libs": [
    "-lgcc",
    "-lstdc++",
    "-lm",
    "-lc"
  ],

  "objcopy": {
    "output_format": "ihex",
    "remove_sections": [".eeprom"]
  },

  "profiles": {
    "release": {
      "compile_flags": ["-Os", "-flto", "-fno-fat-lto-objects"],
      "link_flags": ["-flto", "-fuse-linker-plugin"]
    },
    "quick": {
      "compile_flags": ["-Os"],
      "link_flags": []
    }
  },

  "defines": [
    ["ARDUINO", "10808"]
  ],

  "arduino_mbed_flash": {
    "boards": [
      "giga_r1_m7", "giga_r1_m4", "portenta_h7_m7", "portenta_h7_m4",
      "opta", "opta_m4", "nicla_vision", "nicla_vision_m4"
    ],
    "m4_boards": ["giga_r1_m4", "portenta_h7_m4", "opta_m4", "nicla_vision_m4"],
    "external_ram_m4_boards": ["giga_r1_m4", "portenta_h7_m4"],
    "default_layout": "50_50",
    "external_ram_layout": "100_0",
    "cm4_binary_start": {
      "50_50": "0x08100000",
      "75_25": "0x08180000",
      "100_0": "0x60000000"
    },
    "cm4_binary_end": "0x08200000",
    "external_cm4_binary_end": "0x60040000",
    "external_cm4_ram_end": "0x60080000"
  }
}
